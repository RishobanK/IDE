/*
 * SPDX-License-Identifier: Apache-2.0
 * Application Devicetree Overlay: app/app.overlay
 *
 * Target Board: custom_sensor_node (primary)
 *               nrf52840dk_nrf52840 (fallback for development kit)
 *
 * The custom_sensor_node board DTS already defines i2c1/bme280 and spi1/lsm6dso.
 * This overlay is a COMPATIBILITY layer for the nRF52840-DK dev kit only.
 *
 * When building for custom_sensor_node:
 *   west build -b custom_sensor_node app
 *   → Sensor nodes come from custom_sensor_node.dts; this overlay is a no-op.
 *
 * When building for nRF52840-DK (fallback):
 *   west build -b nrf52840dk_nrf52840 app
 *   → This overlay activates to wire the sensors onto the Arduino headers.
 */

/ {
	chosen {
		/*
		 * When using the nRF52840-DK, the RTT backend is still preferred.
		 * zephyr,console is NOT set here; RTT is selected entirely via Kconfig.
		 */
	};

	aliases {
		sensor-bme280  = &bme280;
		sensor-lsm6dso = &lsm6dso;
		led-status     = &led0;
		led-ble        = &led1;
	};
};

/* ---- Pin Control (nRF52840-DK Arduino header fallback) ----
 * Only activates when custom_sensor_node-pinctrl.dtsi is NOT already included.
 * On nRF52840-DK the pinctrl block is provided by the board DTS itself. */
&pinctrl {
	i2c1_default: i2c1_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
			        <NRF_PSEL(TWIM_SCL, 0, 27)>;
			bias-pull-up;
		};
	};

	i2c1_sleep: i2c1_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 26)>,
			        <NRF_PSEL(TWIM_SCL, 0, 27)>;
			low-power-enable;
		};
	};

	spi1_default: spi1_default {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  0, 31)>,
			        <NRF_PSEL(SPIM_MOSI, 0, 30)>;
		};
		group2 {
			psels = <NRF_PSEL(SPIM_MISO, 0, 29)>;
			bias-disable;
		};
	};

	spi1_sleep: spi1_sleep {
		group1 {
			psels = <NRF_PSEL(SPIM_SCK,  0, 31)>,
			        <NRF_PSEL(SPIM_MOSI, 0, 30)>,
			        <NRF_PSEL(SPIM_MISO, 0, 29)>;
			low-power-enable;
		};
	};
};

/* ---- I2C1 Bus with BME280 (nRF52840-DK fallback) ---- */
&i2c1 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	pinctrl-0 = <&i2c1_default>;
	pinctrl-1 = <&i2c1_sleep>;
	pinctrl-names = "default", "sleep";
	clock-frequency = <I2C_BITRATE_FAST>;

	bme280: bme280@76 {
		compatible = "bosch,bme280";
		reg = <0x76>;
		status = "okay";
	};
};

/* ---- SPI1 Bus with LSM6DSO (nRF52840-DK fallback) ---- */
&spi1 {
	status = "okay";
	compatible = "nordic,nrf-spim";
	pinctrl-0 = <&spi1_default>;
	pinctrl-1 = <&spi1_sleep>;
	pinctrl-names = "default", "sleep";
	cs-gpios = <&gpio0 17 GPIO_ACTIVE_LOW>;

	lsm6dso: lsm6dso@0 {
		compatible = "st,lsm6dso";
		reg = <0>;
		spi-max-frequency = <8000000>;
		irq-gpios = <&gpio0 19 GPIO_ACTIVE_HIGH>;
		status = "okay";
	};
};
